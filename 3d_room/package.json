{
  "name": "blueprint3d",
  "version": "0.0.1",
  "description": "",
  "license": "(MIT OR Apache-2.0)",
  "main": "main.js",
  "dependencies": {
    "@gltf-transform/core": "^4.3.0",
    "@gltf-transform/extensions": "^4.3.0",
    "@gltf-transform/functions": "^4.3.0",
    "@mlightcad/libredwg-web": "^0.6.6",
    "bootstrap": "^3.3.1",
    "bootstrap-tour": "^0.10.1",
    "cors": "^2.8.6",
    "dxf-parser": "^1.1.2",
    "express": "^5.2.1",
    "inherits": "^2.0.1",
    "jquery": "^2.1.3",
    "multer": "^2.0.2",
    "polygon": "^0.1.0",
    "segseg": "^0.2.1",
    "sharp": "^0.34.5",
    "three": "^0.69.0",
    "underscore": "^1.7.0",
    "vec2": "^1.6.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "typescript": "^5.9.3",
    "vite": "^8.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Ekki/blueprint3d.git"
  },
  "scripts": {
    "build:ts": "tsc -p tsconfig.json",
    "watch:ts": "tsc -w -p tsconfig.json",
    "copy:three": "cp node_modules/three/three.min.js example/js/three.min.js",
    "build": "npm run copy:three && npm run build:ts",
    "dev": "concurrently -n ts,api,py,web -c blue,green,yellow,magenta \"npm:watch:ts\" \"node model-server.js\" \"npm:backend\" \"vite\"",
    "serve": "vite",
    "backend": "cd ../backend && venv/bin/uvicorn main:app --port 8080 --reload",
    "check:models": "node tools/check-model-serving.mjs",
    "check:catalogue": "node tools/check-catalogue-ids.mjs",
    "start": "node model-server.js",
    "convert": "node gltf-to-threejs-json.js"
  },
  "author": ""
}
