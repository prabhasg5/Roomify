{
  "name": "blueprint3d",
  "version": "0.0.1",
  "description": "",
  "license": "(MIT OR Apache-2.0)",
  "dependencies": {
    "@gltf-transform/core": "^4.3.0",
    "@gltf-transform/extensions": "^4.3.0",
    "@gltf-transform/functions": "^4.3.0",
    "@mlightcad/libredwg-web": "^0.6.6",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "dxf-parser": "^1.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1",
    "three-r69": "npm:three@0.69.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "concurrently": "^10.0.3",
    "typescript": "^5.9.3",
    "vite": "^8.1.0",
    "vitest": "5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Ekki/blueprint3d.git"
  },
  "scripts": {
    "copy:three": "cp node_modules/three-r69/three.min.js ar_legacy/three/three.min.js",
    "dev": "npm run copy:three && concurrently -n py,ar,web -c green,cyan,magenta \"npm:backend\" \"npm:ar\" \"vite\"",
    "build": "npm run copy:three && vite build",
    "preview": "vite preview --port 4173",
    "backend": "cd ../backend && venv/bin/uvicorn main:app --port 8080 --reload",
    "ar": "cd ../backend && venv/bin/uvicorn main:app --host 0.0.0.0 --port 8002 --ssl-keyfile ../3d_room/ar_view/key.pem --ssl-certfile ../3d_room/ar_view/cert.pem",
    "typecheck": "tsc -p app/tsconfig.json",
    "check:catalogue": "node tools/check-catalogue-ids.mjs",
    "test": "vitest run"
  },
  "author": ""
}
