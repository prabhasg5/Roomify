# The repo's only .gitignore — keep rules here, not in subfolders.

# Dependencies
node_modules/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
*.egg-info/
dist/
build/

# Environment variables / secrets
.env
.env.local
.env.*.local
*.env

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Build outputs
*.glb
*.gltf
# ...except the catalogue's own GLBs (catalogue.json points at them); the
# 281k-face problem upload stays local (stage-2 test asset).
!3d_room/example/models/glb/*.glb
3d_room/example/models/glb/white-sofa-1790761067934.glb
# r69, AR only (ar-dynamic.html via /three); written by `npm run copy:three`
3d_room/ar_legacy/three/three.min.js

# TLS keypair for the AR server (generate locally, never commit)
3d_room/ar_view/*.pem

# Uploaded/generated files
3d_room/ar_view/models/
3d_room/ar_view/designs/
3d_room/uploads/
3d_room/uploads-debug/
3d_room/example/models/uploads/

# Parked 2D image-generation app (no longer in use) — its local data
parked/2d_image_generation/*.db
parked/2d_image_generation/uploads/
parked/2d_image_generation/images/
parked/2d_image_generation/static/images/

# Temporary files
*.tmp
*.temp
.cache/

# Test coverage
.coverage
htmlcov/
.pytest_cache/

# Jupyter
.ipynb_checkpoints/

# Working-context docs — local only, README.md stays tracked
*.md
!README.md

# Local tool output
.enola/
brag-output/
